# Don't install on linux
{{- if eq .chezmoi.os "linux" }}
bin/appify
{{- end }}

dockerise

# Don't install on Darwin
{{- if eq .chezmoi.os "darwin" }}
.screenlayout/vm.sh
.config/i3
{{- end }}

# Do not ship Cursor account/machine state (auth, team, MCP allowlists).
# Patterns match target paths, not source paths. A dot_cursor/ prefix matches
# nothing and leaves the file unprotected.
.cursor/cli-config.json
.cursor/**/cli-config.json

# Do not ship the per-session cost ledgers that statusline.sh writes.
.cursor/cost
.cursor/cost/**

# Never manage installed dependencies. These are rebuilt by the package manager,
# and a stray `chezmoi add` of one pulls thousands of files into the source state.
**/node_modules
**/node_modules/**

# Python build output. The editable pi-job install and any local test run write
# these into the applied tree, which otherwise reports a dirty target on apply.
**/__pycache__
**/__pycache__/**
**/*.egg-info
**/*.egg-info/**
