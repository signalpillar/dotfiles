#!/usr/bin/env bash
# Put pi-job-serve on PATH from the applied viewer tree.
#
# This script is the only owner of ~/.local/bin/pi-job-serve.
# Editable install keeps no snapshot, so new routes land without reinstall.
#
# pyproject hash: {{ include "dot_local/share/pi-job-viewer/pyproject.toml" | sha256sum }}

set -euo pipefail

PKG="${HOME}/.local/share/pi-job-viewer"

if ! command -v uv >/dev/null 2>&1; then
  echo "pi-job-serve: uv is required; see https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 1
fi

# The viewer is an ignored target on machines that do not ship it.
if [[ ! -f "${PKG}/pyproject.toml" ]]; then
  echo "pi-job-serve: ${PKG} is not applied; skipping install" >&2
  exit 0
fi

uv tool install --force --editable "${PKG}"

# Loud failure here beats a user that discovers a broken viewer at click time.
if ! "${HOME}/.local/bin/pi-job-serve" --help >/dev/null 2>&1; then
  echo "pi-job-serve: installed entry point does not run; check ${PKG}" >&2
  exit 1
fi

echo "pi-job-serve: editable install from ${PKG}"
