"""Deterministic task harness prototype for pi-agent jobs.

The selected TaskStore is the source of truth. YAML is the preferred task format;
legacy CUE files and directory-backed tasks remain readable. The package-local YAML
profile defines step and slice-kind behavior.
"""

from __future__ import annotations

import argparse
import difflib
import fcntl
import hashlib
import json
import os
import re
import shutil
